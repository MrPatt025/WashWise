{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    { "repo": "washwise/washwise" }
  ],
  "commit": false,
  "fixed": [],
  "linked": [
    ["@washwise/api-server", "@washwise/web-admin"],
    ["@washwise/config", "@washwise/database", "@washwise/types"]
  ],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": ["@washwise/e2e"],
