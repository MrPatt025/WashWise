# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# TypeScript/JavaScript files
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Prisma schema
[*.prisma]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4
end_of_line = lf

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf

# Dockerfile
[Dockerfile*]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Git configuration
[.git*]
indent_size = 4

# Lock files - don't modify
[{pnpm-lock.yaml,package-lock.json,yarn.lock}]
indent_size = 2
insert_final_newline = false
