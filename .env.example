# ==================================
# WashWise Environment Configuration
# ==================================
# Copy this file to .env and fill in your values

# ============ DATABASE ============
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washwise?schema=public"

# ============ REDIS ============
REDIS_URL="redis://localhost:6379"

# ============ JWT SECRETS ============
# IMPORTANT: Generate secure secrets for production!
# Use: openssl rand -base64 64
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"

# ============ SERVER ============
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# ============ CORS ============
CORS_ORIGIN="http://localhost:3000"

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL="http://localhost:3001"
