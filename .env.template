# =====================================
# WashWise Environment Configuration
# =====================================
# Copy this file to .env and customize for your environment
# Generate secrets with: openssl rand -base64 64

# ============ APPLICATION ============
NODE_ENV=development
TZ=UTC
LOG_LEVEL=debug

# ============ API SERVER ============
PORT=3001
HOST=0.0.0.0
API_VERSION=v1

# ============ DATABASE ============
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://washwise:washwise@localhost:5432/washwise?schema=public

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============ REDIS ============
# Redis connection string
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ JWT AUTHENTICATION ============
# CRITICAL: Generate secure secrets for production!
# Use: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_ISSUER=washwise-api
JWT_AUDIENCE=washwise-client

# Token expiration settings
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============ COOKIE SETTINGS ============
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost
COOKIE_HTTP_ONLY=true

# ============ CORS ============
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============ RATE LIMITING ============
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============ FRONTEND (Next.js) ============
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=WashWise
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============ OBSERVABILITY ============
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=washwise-api

# ============ EMAIL (Optional) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@washwise.com

# ============ STORAGE (Optional) ============
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ============ SENTRY (Optional) ============
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============ FEATURE FLAGS ============
FEATURE_REALTIME_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false
