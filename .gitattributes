# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Ensure lockfile always uses LF (critical for frozen-lockfile in CI)
pnpm-lock.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
