    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@washwise/config": "workspace:*",
    "@washwise/database": "workspace:*",
    "@washwise/types": "workspace:*",
    "argon2": "^0.44.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.4",
