{
  "name": "washwise",
  "version": "1.1.11",
  "private": true,
  "description": "WashWise - Smart Laundromat Management Platform",
  "keywords": [
    "laundromat",
    "iot",
    "smart-laundry",
    "saas",
    "multi-tenant",
    "nextjs",
    "fastify",
    "prisma",
    "typescript"
  ],
  "homepage": "https://github.com/washwise/washwise#readme",
  "bugs": {
    "url": "https://github.com/washwise/washwise/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/washwise/washwise.git"
  },
  "license": "MIT",
  "author": "WashWise Team",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:packages": "pnpm --filter @washwise/config build && pnpm --filter @washwise/types build && pnpm --filter @washwise/database build",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rimraf node_modules",
    "clean:cache": "turbo daemon stop",
    "db:generate": "pnpm --filter @washwise/database generate",
    "db:migrate": "pnpm --filter @washwise/database migrate:dev",
    "db:push": "pnpm --filter @washwise/database push",
    "db:reset": "pnpm --filter @washwise/database exec prisma migrate reset",
    "db:seed": "pnpm --filter @washwise/database seed",
    "db:studio": "pnpm --filter @washwise/database studio",
    "dev": "turbo dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm db:generate && pnpm build:packages",
    "lint": "turbo lint",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "release": "pnpm build && changeset publish",
    "start": "turbo start",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "test:e2e": "pnpm --filter @washwise/e2e test",
    "test:integration": "turbo test:integration",
    "test:watch": "turbo test:watch",
    "typecheck": "turbo build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.28.0",
    "@types/node": "^25.2.0",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "only-allow": "^1.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.1",
    "sort-package-json": "^3.0.0",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.33.1"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "hono": ">=4.11.7",
      "lodash": ">=4.17.23"
    }
  }
}
