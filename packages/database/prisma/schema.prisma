// Prisma schema for WashWise - Smart Laundromat Management Platform v2.x
// Production-ready multi-tenant architecture with comprehensive business features

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [btree_gist, pgcrypto]
}

// ============================================
// 1. TENANT & BRANCH (Multi-tenancy)
// ============================================
model Tenant {
  id          String     @id @default(uuid())
  slug        String     @unique @db.VarChar(50) // URL-friendly identifier
  name        String     @db.VarChar(100)
  plan        TenantPlan @default(FREE)
  isActive    Boolean    @default(true) @map("is_active")
  
  // Contact & Billing
  email       String?    @db.VarChar(255)
  phone       String?    @db.VarChar(20)
  taxId       String?    @map("tax_id") @db.VarChar(50)
  
  // Settings (JSON for flexibility)
  settings    Json       @default("{}")
  
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  branches           Branch[]
  users              User[]
  machines           Machine[]
  bookings           Booking[]
  payments           Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  notificationConfig NotificationConfig[]

  @@index([slug])
  @@index([isActive])
  @@map("tenants")
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(20) // Branch code (e.g., "BKK-001")
  address     String?  @db.Text
  latitude    Float?
  longitude   Float?
  phone       String?  @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  
  // Operating hours (JSON for flexibility)
  operatingHours Json? @map("operating_hours")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  machines    Machine[]
  users       User[]    @relation("BranchStaff")
  bookings    Booking[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

enum TenantPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ============================================
// 2. USER & RBAC (Role-Based Access Control)
// ============================================
model User {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  email            String    @db.VarChar(255)
  password         String    @db.VarChar(255)
  name             String    @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  role             UserRole  @default(CUSTOMER)
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  
  // LINE integration
  lineUserId       String?   @unique @map("line_user_id") @db.VarChar(50)
  
  // Security
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip") @db.VarChar(45)
  
  // Profile
  avatarUrl        String?   @map("avatar_url") @db.VarChar(500)
  preferences      Json      @default("{}") // User preferences

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches         Branch[]       @relation("BranchStaff") // Staff can be assigned to multiple branches
  refreshTokens    RefreshToken[]
  bookings         Booking[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@unique([tenantId, email]) // Email unique per tenant
  @@index([tenantId])
  @@index([email])
  @@index([lineUserId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN  // Platform administrator (cross-tenant)
  OWNER        // Tenant owner (full access within tenant)
  STAFF        // Branch staff (limited access)
  CUSTOMER     // End customer
}

// ============================================
// 3. MACHINE (Inventory & Health)
// ============================================
model Machine {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  branchId          String        @map("branch_id")
  
  // Identification
  serialNumber      String        @map("serial_number") @db.VarChar(50)
  label             String        @db.VarChar(100) // Display name (e.g., "Washer #1")
  qrCode            String?       @unique @map("qr_code") @db.VarChar(100)
  
  // Specifications
  type              MachineType
  capacityKg        Float         @map("capacity_kg")
  manufacturer      String?       @db.VarChar(100)
  model             String?       @db.VarChar(100)
  
  // Pricing
  pricePerCycle     Int           @default(0) @map("price_per_cycle") // in minor units
  cycleDurationMins Int           @default(45) @map("cycle_duration_mins")
  
  // Status & Health
  status            MachineStatus @default(AVAILABLE)
  isActive          Boolean       @default(true) @map("is_active")
  
  // Health monitoring
  lastHeartbeat     DateTime?     @map("last_heartbeat")
  errorCount        Int           @default(0) @map("error_count")
  lastErrorAt       DateTime?     @map("last_error_at")
  lastErrorMessage  String?       @map("last_error_message") @db.Text
  anomalyFlag       Boolean       @default(false) @map("anomaly_flag")
  anomalyDetails    Json?         @map("anomaly_details")
  
  // Maintenance
  lastMaintenanceAt DateTime?     @map("last_maintenance_at")
  nextMaintenanceAt DateTime?     @map("next_maintenance_at")
  totalCycles       Int           @default(0) @map("total_cycles")
  
  // Installation
  installedAt       DateTime?     @map("installed_at")
  warrantyExpiresAt DateTime?     @map("warranty_expires_at")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  iotLogs           IoTLog[]
  machineMetrics    MachineMetrics[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([lastHeartbeat])
  @@map("machines")
}

model MachineMetrics {
  id              String   @id @default(uuid())
  machineId       String   @map("machine_id")
  
  // Metrics (hourly aggregates)
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  
  cycleCount      Int      @default(0) @map("cycle_count")
  revenue         Int      @default(0) // in minor units
  utilizationPct  Float    @default(0) @map("utilization_pct")
  errorCount      Int      @default(0) @map("error_count")
  avgCycleDuration Float?  @map("avg_cycle_duration")
  
  createdAt       DateTime @default(now()) @map("created_at")

  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, periodStart])
  @@index([machineId])
  @@index([periodStart])
  @@map("machine_metrics")
}

enum MachineType {
  WASHER
  DRYER
  COMBO // Washer-Dryer combo
}

enum MachineStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
  ERROR
}

// ============================================
// 4. BOOKING (Time-slot with overlap protection)
// ============================================
model Booking {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  machineId       String        @map("machine_id")
  userId          String        @map("user_id")
  
  // Time slot
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  
  // Status
  status          BookingStatus @default(PENDING)
  
  // Pricing snapshot (in case prices change)
  priceSnapshot   Int           @map("price_snapshot")
  
  // Cancellation
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelReason    String?       @map("cancel_reason") @db.Text
  
  // Check-in/out
  checkedInAt     DateTime?     @map("checked_in_at")
  completedAt     DateTime?     @map("completed_at")
  
  // Notes
  notes           String?       @db.Text
  
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  machine         Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment         Payment?

  @@index([tenantId])
  @@index([branchId])
  @@index([machineId])
  @@index([userId])
  @@index([startTime])
  @@index([status])
  // Note: Overlap protection via raw SQL constraint (EXCLUDE USING GIST)
  @@map("bookings")
}

enum BookingStatus {
  PENDING      // Awaiting payment
  CONFIRMED    // Payment received, slot reserved
  CHECKED_IN   // Customer started using machine
  COMPLETED    // Cycle finished
  CANCELLED    // Cancelled by user or system
  NO_SHOW      // Customer didn't show up
  EXPIRED      // Booking expired without check-in
}

// ============================================
// 5. PAYMENT (Production-ready)
// ============================================
model Payment {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  userId            String        @map("user_id")
  bookingId         String?       @unique @map("booking_id")
  
  // Idempotency
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(100)
  
  // Amount
  amount            Int           // Total in minor units
  currency          String        @default("THB") @db.VarChar(3)
  
  // Payment method
  method            PaymentMethod
  
  // Status
  status            PaymentStatus @default(PENDING)
  
  // External provider
  provider          String?       @db.VarChar(50) // e.g., "stripe", "omise", "promptpay"
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(255)
  providerData      Json?         @map("provider_data") // Full response from provider
  
  // Timeline
  initiatedAt       DateTime      @default(now()) @map("initiated_at")
  confirmedAt       DateTime?     @map("confirmed_at")
  failedAt          DateTime?     @map("failed_at")
  refundedAt        DateTime?     @map("refunded_at")
  
  // Failure info
  failureCode       String?       @map("failure_code") @db.VarChar(50)
  failureMessage    String?       @map("failure_message") @db.Text
  
  // Refund
  refundAmount      Int?          @map("refund_amount")
  refundReason      String?       @map("refund_reason") @db.Text
  
  // Receipt
  receiptUrl        String?       @map("receipt_url") @db.VarChar(500)
  receiptNumber     String?       @unique @map("receipt_number") @db.VarChar(50)
  
  // Metadata
  metadata          Json          @default("{}")
  
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  webhookEvents     PaymentWebhookEvent[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([provider, providerPaymentId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  
  // Event details
  eventType       String   @map("event_type") @db.VarChar(100)
  eventId         String?  @map("event_id") @db.VarChar(255) // Provider's event ID
  
  // Payload
  payload         Json
  
  // Processing
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error") @db.Text
  
  createdAt       DateTime  @default(now()) @map("created_at")

  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventId])
  @@map("payment_webhook_events")
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PROMPTPAY
  BANK_TRANSFER
  LINE_PAY
  TRUE_MONEY
  RABBIT_LINE_PAY
  WALLET // In-app wallet
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ============================================
// 6. NOTIFICATIONS
// ============================================
model Notification {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  userId          String             @map("user_id")
  
  // Content
  type            NotificationType
  title           String             @db.VarChar(200)
  body            String             @db.Text
  data            Json               @default("{}") // Additional structured data
  
  // Delivery
  channels        NotificationChannel[]
  
  // Status per channel
  deliveryStatus  Json               @default("{}") @map("delivery_status")
  
  // Read status
  readAt          DateTime?          @map("read_at")
  
  // Scheduling
  scheduledFor    DateTime?          @map("scheduled_for")
  sentAt          DateTime?          @map("sent_at")
  
  // Priority
  priority        NotificationPriority @default(NORMAL)
  
  createdAt       DateTime           @default(now()) @map("created_at")

  // Relations
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([scheduledFor])
  @@map("notifications")
}

model NotificationConfig {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  
  // Channel configurations
  lineChannelId       String?  @map("line_channel_id") @db.VarChar(100)
  lineChannelSecret   String?  @map("line_channel_secret") @db.VarChar(255)
  lineAccessToken     String?  @map("line_access_token") @db.Text
  
  smtpHost            String?  @map("smtp_host") @db.VarChar(255)
  smtpPort            Int?     @map("smtp_port")
  smtpUser            String?  @map("smtp_user") @db.VarChar(255)
  smtpPassword        String?  @map("smtp_password") @db.VarChar(255)
  smtpFromEmail       String?  @map("smtp_from_email") @db.VarChar(255)
  smtpFromName        String?  @map("smtp_from_name") @db.VarChar(100)
  
  firebaseProjectId   String?  @map("firebase_project_id") @db.VarChar(100)
  firebaseCredentials Json?    @map("firebase_credentials")
  
  // Templates
  templates           Json     @default("{}") // Notification templates
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("notification_configs")
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  CYCLE_STARTED
  CYCLE_COMPLETED
  CYCLE_ALMOST_DONE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  MACHINE_ERROR
  PROMOTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  LINE
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// 7. AUDIT LOG
// ============================================
model AuditLog {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  userId          String?      @map("user_id")
  
  // Action details
  action          AuditAction
  entityType      String       @map("entity_type") @db.VarChar(50)
  entityId        String?      @map("entity_id") @db.VarChar(100)
  
  // Changes
  oldValues       Json?        @map("old_values")
  newValues       Json?        @map("new_values")
  
  // Context
  ipAddress       String?      @map("ip_address") @db.VarChar(45)
  userAgent       String?      @map("user_agent") @db.Text
  requestId       String?      @map("request_id") @db.VarChar(100)
  
  // Additional metadata
  metadata        Json         @default("{}")
  
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  ROLE_CHANGE
  PAYMENT
  BOOKING
  MACHINE_STATUS_CHANGE
  SETTINGS_CHANGE
}

// ============================================
// 8. IOT & TELEMETRY
// ============================================
model IoTLog {
  id              String   @id @default(uuid())
  machineId       String   @map("machine_id")
  
  // Event info
  eventType       String   @map("event_type") @db.VarChar(50)
  eventData       Json     @map("event_data")
  
  // Device info
  deviceId        String?  @map("device_id") @db.VarChar(100)
  firmwareVersion String?  @map("firmware_version") @db.VarChar(50)
  
  // Timestamp
  timestamp       DateTime @default(now())

  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([eventType])
  @@index([timestamp])
  @@map("iot_logs")
}

// ============================================
// 9. SECURITY (Token Management)
// ============================================
model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique @map("hashed_token") @db.VarChar(255)
  userId      String   @map("user_id")
  familyId    String   @map("family_id")
  revoked     Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  
  // Device info
  deviceInfo  String?  @map("device_info") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// 10. DASHBOARD ANALYTICS (Materialized views alternative)
// ============================================
model DailyTenantStats {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  date            DateTime @db.Date
  
  // Booking stats
  totalBookings   Int      @default(0) @map("total_bookings")
  completedBookings Int    @default(0) @map("completed_bookings")
  cancelledBookings Int    @default(0) @map("cancelled_bookings")
  noShowBookings  Int      @default(0) @map("no_show_bookings")
  
  // Revenue
  totalRevenue    Int      @default(0) @map("total_revenue") // in minor units
  avgTicketSize   Int      @default(0) @map("avg_ticket_size")
  
  // Utilization
  machineUtilization Float @default(0) @map("machine_utilization") // percentage
  peakHour        Int?     @map("peak_hour") // 0-23
  
  // Customers
  newCustomers    Int      @default(0) @map("new_customers")
  returningCustomers Int   @default(0) @map("returning_customers")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
  @@map("daily_tenant_stats")
}

model DailyBranchStats {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  branchId        String   @map("branch_id")
  date            DateTime @db.Date
  
  // Same metrics as tenant but per branch
  totalBookings   Int      @default(0) @map("total_bookings")
  completedBookings Int    @default(0) @map("completed_bookings")
  totalRevenue    Int      @default(0) @map("total_revenue")
  machineUtilization Float @default(0) @map("machine_utilization")
  
  // Machine breakdown
  washerRevenue   Int      @default(0) @map("washer_revenue")
  dryerRevenue    Int      @default(0) @map("dryer_revenue")
  washerCycles    Int      @default(0) @map("washer_cycles")
  dryerCycles     Int      @default(0) @map("dryer_cycles")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([branchId, date])
  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("daily_branch_stats")
}
