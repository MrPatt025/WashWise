// Prisma schema for WashWise - Smart Laundromat Management Platform v2.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. Tenant (Multi-tenancy root entity)
// ============================================
model Tenant {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(100)
  plan      TenantPlan @default(FREE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relations
  users    User[]
  machines Machine[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ============================================
// 2. User (RBAC & Auth)
// ============================================
model User {
  id               String    @id @default(uuid())
  email            String    @unique @db.VarChar(255)
  password         String    @db.VarChar(255)
  name             String    @db.VarChar(100)
  role             UserRole  @default(STAFF)
  tenantId         String    @map("tenant_id")

  // Security
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  transactions  Transaction[]

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  STAFF
  CUSTOMER
}

// ============================================
// 3. Machine (Core Business Logic)
// ============================================
model Machine {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  serialNumber  String        @map("serial_number") @db.VarChar(50)
  label         String        @db.VarChar(100)
  type          MachineType
  capacityKg    Float         @map("capacity_kg")
  status        MachineStatus @default(AVAILABLE)
  pricePerCycle Float         @default(0) @map("price_per_cycle")
  location      String?       @db.VarChar(200)

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  iotLogs      IoTLog[]

  // Constraint: Serial unique per shop
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@map("machines")
}

enum MachineType {
  WASHER
  DRYER
}

enum MachineStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
}

// ============================================
// 4. Security (Token Rotation)
// ============================================
model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique @map("hashed_token") @db.VarChar(255)
  userId      String   @map("user_id")
  familyId    String   @map("family_id")
  revoked     Boolean  @default(false)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ============================================
// 5. IoT Telemetry & Analytics
// ============================================
model IoTLog {
  id        String   @id @default(uuid())
  machineId String   @map("machine_id")
  event     String
  payload   Json?
  timestamp DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([timestamp])
  @@map("iot_logs")
}

// ============================================
// 6. Transaction (Payment Tracking)
// ============================================
model Transaction {
  id        String        @id @default(uuid())
  amount    Int           // minor units (satang/cents)
  status    PaymentStatus @default(PENDING)

  userId    String?       @map("user_id")
  machineId String        @map("machine_id")

  createdAt DateTime      @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  @@index([userId])
  @@index([machineId])
  @@map("transactions")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
